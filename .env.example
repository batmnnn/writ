# Copy to .env and fill in locally. Never commit .env.
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Returned once by POST /api/v1/issuing/config/update (RA mode only)
AIRWALLEX_RA_SHARED_SECRET=
# ra or frozen
WRIT_MODE=frozen
WRIT_RA_PUBLIC_URL=
WRIT_APPROVER_PUBKEY_PATH=keys/approver.pub
WRIT_AUTO_APPROVE_MINOR=25000
WRIT_RING_FENCE_MINOR=2500000
WRIT_RESERVE_FLOOR_MINOR=2000000
WRIT_FETCH_ALLOWLIST=
WRIT_DB_PATH=.writ/writ.sqlite
# Agent scene (WritAgent stack outputs; the client secret comes from describe-user-pool-client)
WRIT_URL=
WRIT_AGENT_RUNTIME_ARN=
WRIT_AGENT_TOKEN_URL=
WRIT_AGENT_CLIENT_ID=
WRIT_AGENT_CLIENT_SECRET=
WRIT_AGENT_GATEWAY_URL=
WRIT_LEDGER_PUBLIC_KEY=
